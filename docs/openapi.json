{
  "openapi": "3.0.3",
  "info": {
    "title": "RailSense Delay Intelligence & Prediction REST API",
    "description": "High-performance, leakage-safe REST API for Indian Railways delay intelligence, historical pattern exploration, and pre-departure delay probability forecasting. Built with Flask, precomputed SQLite serving store, and calibrated LightGBM GBDT models.",
    "version": "1.0.0",
    "contact": {
      "name": "RailSense Project Team"
    }
  },
  "servers": [
    {
      "url": "http://localhost:5000",
      "description": "Local development server"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Lightweight Liveness Probe",
        "description": "Returns 200 OK without database or disk I/O for container liveness monitoring.",
        "responses": {
          "200": {
            "description": "Service is live",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "healthy" },
                    "service": { "type": "string", "example": "RailSense API" },
                    "version": { "type": "string", "example": "1.0.0" },
                    "timestamp": { "type": "string", "example": "2026-10-29 21:00:00 UTC" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/health/ready": {
      "get": {
        "summary": "Readiness Probe",
        "description": "Validates model artifact readiness, serving store connectivity, and live TiDB Cloud connectivity (with 3-second timeout).",
        "responses": {
          "200": { "description": "All subsystems ready" },
          "503": { "description": "Subsystem unavailable" }
        }
      }
    },
    "/api/overview": {
      "get": {
        "summary": "Dataset Macro Overview",
        "description": "Returns macro dataset statistics, delayed definition, category breakdown, and worst observed delay hotspots.",
        "responses": {
          "200": {
            "description": "Macro overview statistics"
          }
        }
      }
    },
    "/api/trains": {
      "get": {
        "summary": "Search & Paginate Train Catalog",
        "description": "Search trains by train_number prefix or train_name substring, with optional category filter.",
        "parameters": [
          { "name": "q", "in": "query", "description": "Search train number prefix or train name substring", "schema": { "type": "string" } },
          { "name": "category", "in": "query", "description": "Filter by category (SUB, MEX, SUF, EXP, etc.)", "schema": { "type": "string" } },
          { "name": "page", "in": "query", "description": "Page number (default 1)", "schema": { "type": "integer", "default": 1 } },
          { "name": "page_size", "in": "query", "description": "Items per page (default 20, max 100)", "schema": { "type": "integer", "default": 20 } }
        ],
        "responses": {
          "200": { "description": "Paginated train records" },
          "400": { "description": "Invalid query parameters" }
        }
      }
    },
    "/api/trains/{train_number}": {
      "get": {
        "summary": "Train Profile & Route Schedule",
        "description": "Returns full train profile, canonical stop sequence, per-stop observed delay rates, and historical run statistics.",
        "parameters": [
          { "name": "train_number", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Train route profile and stops schedule" },
          "404": { "description": "Train not found in catalog" }
        }
      }
    },
    "/api/stations": {
      "get": {
        "summary": "Search & Paginate Station Catalog",
        "parameters": [
          { "name": "q", "in": "query", "description": "Search station code prefix", "schema": { "type": "string" } },
          { "name": "page", "in": "query", "description": "Page number (default 1)", "schema": { "type": "integer", "default": 1 } },
          { "name": "page_size", "in": "query", "description": "Items per page (default 20, max 100)", "schema": { "type": "integer", "default": 20 } }
        ],
        "responses": {
          "200": { "description": "Paginated station records with Wilson confidence bounds" },
          "400": { "description": "Invalid query parameters" }
        }
      }
    },
    "/api/stations/{station_code}": {
      "get": {
        "summary": "Station Profile & Calling Trains",
        "parameters": [
          { "name": "station_code", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Station details and top calling trains" },
          "404": { "description": "Station not found in catalog" }
        }
      }
    },
    "/api/patterns/{kind}": {
      "get": {
        "summary": "Temporal & Spatial Empirical Patterns",
        "parameters": [
          {
            "name": "kind",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["hour", "dow", "category", "position", "hotspots"]
            }
          }
        ],
        "responses": {
          "200": { "description": "Precomputed pattern distributions" },
          "400": { "description": "Invalid pattern kind" }
        }
      }
    },
    "/api/model/info": {
      "get": {
        "summary": "Model Architecture & Split Boundaries",
        "description": "Returns deployment model hyperparameters, feature names, banned leaky features, operational thresholds, and temporal split metadata.",
        "responses": {
          "200": { "description": "Deployment model metadata" }
        }
      }
    },
    "/api/model/metrics": {
      "get": {
        "summary": "Evaluation Benchmark Lab",
        "description": "Returns full comparative evaluation across 8 baselines/models with Average Precision (AP), ROC-AUC, Brier score, ECE, PR/ROC curves, and feature importance.",
        "responses": {
          "200": { "description": "Full model evaluation benchmark" }
        }
      }
    },
    "/api/predict": {
      "post": {
        "summary": "Pre-Departure Delay Prediction",
        "description": "Computes calibrated delay probability, risk band, contributing factors, and operational caveats for a scheduled train stop.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["train_number", "station_code", "date"],
                "properties": {
                  "train_number": { "type": "string", "example": "12951" },
                  "station_code": { "type": "string", "example": "BRC" },
                  "date": { "type": "string", "format": "date", "example": "2026-10-26" },
                  "seq": { "type": "integer", "example": 5 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Prediction result with calibrated probability and factors" },
          "400": { "description": "Invalid request payload or date format" },
          "404": { "description": "Train or station not found on route" },
          "422": { "description": "Origin stop (seq=1) or multiple stops require sequence number" }
        }
      }
    }
  }
}
