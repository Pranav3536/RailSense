# =============================================================================
# RailSense — Environment Variables Template
# Copy this file to backend/.env and fill in real values.
# NEVER commit .env — it is gitignored.
# NEVER put a real credential in this file.
# =============================================================================

# ---- Flask Runtime API (Deployed App) ---------------------------------------
FLASK_ENV=development
FLASK_PORT=5000
FLASK_THREADS=4

# ---- CORS -------------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
# Example: http://localhost:5173,https://railsense.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ---- API Limits -------------------------------------------------------------
API_MAX_PAGE_SIZE=100
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=60

# ---- Frontend Build (Vite) --------------------------------------------------
# Only VITE_ prefixed variables are embedded into the client bundle.
VITE_API_BASE_URL=http://localhost:5000/api

# =============================================================================
# OPTIONAL: Offline TiDB Data Refresh Tooling (backend/tools/refresh/)
# The deployed web app DOES NOT READ OR REQUIRE THESE.
# Used ONLY if running manual extraction scripts (extract_data.py).
# =============================================================================
# TIDB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
# TIDB_PORT=4000
# TIDB_USER=your_tidb_username_here
# TIDB_PASSWORD=your_tidb_password_here
# TIDB_DATABASE=railsense
# TIDB_CA_PATH=
# DB_QUERY_TIMEOUT_SECONDS=30
