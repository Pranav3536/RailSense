# =============================================================================
# RailSense — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is gitignored.
# NEVER put a real credential in this file.
# =============================================================================

# ---- TiDB Cloud (MySQL-compatible, TLS required) ----------------------------
TIDB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=your_tidb_username_here
TIDB_PASSWORD=your_tidb_password_here
TIDB_DATABASE=railsense

# Path to TiDB CA certificate (optional).
# Leave blank to use the system CA bundle.
# If TiDB requires a specific cert, download it from the TiDB Cloud console
# and point this to the local path (e.g. /etc/ssl/certs/tidb-ca.pem).
# This file MUST be gitignored — never commit a certificate.
TIDB_CA_PATH=

# ---- Flask ------------------------------------------------------------------
FLASK_ENV=development
FLASK_PORT=5000

# ---- CORS -------------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
# Example: http://localhost:5173,https://railsense.vercel.app
CORS_ORIGINS=http://localhost:5173

# ---- Query / pagination limits ----------------------------------------------
DB_QUERY_TIMEOUT_SECONDS=30
API_MAX_PAGE_SIZE=100

# ---- Frontend build (Vite) --------------------------------------------------
# IMPORTANT: Only VITE_ prefixed variables are embedded into the React bundle
# and therefore visible to any user who opens the browser DevTools.
# A TiDB password, host, or any backend secret MUST NEVER go into a VITE_
# variable. The frontend talks ONLY to the Flask API, never to TiDB directly.
VITE_API_BASE_URL=http://localhost:5000/api
